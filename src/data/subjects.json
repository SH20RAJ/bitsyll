    {
      "id": "MA24101",
      "code": "MA24101",
      "title": "Mathematics I",
      "credits": 4,
      "semester": 1,
      "department": "Mathematics",
      "description": "This course covers differential and integral calculus, differential equations, and linear algebra fundamentals essential for engineering applications.",
      "syllabus": [
        {
          "unit": "Unit 1: Differential Calculus",
          "topics": [
            "Limits and Continuity",
            "Differentiation",
            "Mean Value Theorems",
            "Taylor's and Maclaurin's Series",
            "Maxima and Minima"
          ]
        },
        {
          "unit": "Unit 2: Integral Calculus",
          "topics": [
            "Indefinite Integrals",
            "Definite Integrals",
            "Applications of Definite Integrals",
            "Multiple Integrals"
          ]
        },
        {
          "unit": "Unit 3: Differential Equations",
          "topics": [
            "First Order Differential Equations",
            "Linear Differential Equations",
            "Homogeneous Differential Equations",
            "Applications of Differential Equations"
          ]
        },
        {
          "unit": "Unit 4: Linear Algebra",
          "topics": [
            "Matrices and Determinants",
            "System of Linear Equations",
            "Eigenvalues and Eigenvectors",
            "Diagonalization of Matrices"
          ]
        },
        {
          "unit": "Unit 5: Vector Calculus",
          "topics": [
            "Vector Differentiation",
            "Gradient, Divergence, and Curl",
            "Vector Integration",
            "Line, Surface, and Volume Integrals"
          ]
        }
      ],
      "books": [
        {
          "title": "Advanced Engineering Mathematics",
          "author": "Erwin Kreyszig",
          "publisher": "Wiley",
          "edition": "10th Edition"
        },
        {
          "title": "Higher Engineering Mathematics",
          "author": "B.S. Grewal",
          "publisher": "Khanna Publishers",
          "edition": "44th Edition"
        },
        {
          "title": "Calculus and Analytic Geometry",
