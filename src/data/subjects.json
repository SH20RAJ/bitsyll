    {
      "id": "ME24101",
      "code": "ME24101",
      "title": "Engineering Mechanics",
      "credits": 4,
      "semester": 1,
      "department": "Mechanical Engineering",
      "description": "Study of forces and their effects on engineering systems in static and dynamic conditions. Covers equilibrium, friction, centroids, moments of inertia, and kinematics.",
      "syllabus": [
        {
          "unit": "Unit 1: Fundamentals of Mechanics",
          "topics": [
            "Units and Dimensions",
            "Laws of Mechanics",
            "Vectors and Scalars",
            "Force Systems"
          ]
        },
        {
          "unit": "Unit 2: Statics",
          "topics": [
            "Equilibrium of Particles",
            "Free Body Diagrams",
            "Equilibrium of Rigid Bodies",
            "Structural Analysis"
          ]
        },
        {
          "unit": "Unit 3: Friction",
          "topics": [
            "Laws of Friction",
            "Applications of Friction",
            "Belt Friction",
            "Rolling Resistance"
          ]
        },
        {
          "unit": "Unit 4: Centroids and Moments of Inertia",
          "topics": [
            "Centroids of Lines, Areas, and Volumes",
            "Theorems of Pappus and Guldinus",
            "Moments of Inertia",
            "Parallel Axis Theorem"
          ]
        },
        {
          "unit": "Unit 5: Dynamics",
          "topics": [
            "Kinematics of Particles",
            "Kinetics of Particles",
            "Work-Energy Principle",
            "Impulse and Momentum"
          ]
        }
      ],
      "books": [
        {
          "title": "Engineering Mechanics: Statics and Dynamics",
          "author": "R.C. Hibbeler",
          "publisher": "Pearson",
          "edition": "14th Edition"
        },
        {
          "title": "Vector Mechanics for Engineers: Statics and Dynamics",
