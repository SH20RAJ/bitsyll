    {
      "id": "EC24101",
      "code": "EC24101",
      "title": "Basic Electronics",
      "credits": 4,
      "semester": 1,
      "department": "Electronics and Communication Engineering",
      "description": "Introduction to electronic devices, circuits, and systems. Topics include semiconductor devices, amplifiers, digital circuits, and basic communication systems.",
      "syllabus": [
        {
          "unit": "Unit 1: Semiconductor Devices",
          "topics": [
            "Semiconductor Materials",
            "PN Junction Diodes",
            "Bipolar Junction Transistors",
            "Field Effect Transistors"
          ]
        },
        {
          "unit": "Unit 2: Analog Circuits",
          "topics": [
            "Diode Applications",
            "Transistor Biasing",
            "Small Signal Amplifiers",
            "Power Amplifiers"
          ]
        },
        {
          "unit": "Unit 3: Operational Amplifiers",
          "topics": [
            "Op-Amp Characteristics",
            "Linear Applications",
            "Non-linear Applications",
            "Active Filters"
          ]
        },
        {
          "unit": "Unit 4: Digital Electronics",
          "topics": [
            "Number Systems and Boolean Algebra",
            "Logic Gates",
            "Combinational Circuits",
            "Sequential Circuits"
          ]
        },
        {
          "unit": "Unit 5: Communication Systems",
          "topics": [
            "Modulation Techniques",
            "Transmitters and Receivers",
            "Digital Communication",
            "Introduction to Microwave Engineering"
          ]
        }
      ],
