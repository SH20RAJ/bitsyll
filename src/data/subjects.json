{
  "subjects": [
    {
      "id": "CS24101",
      "code": "CS24101",
      "title": "Computer Programming",
      "credits": 4,
      "semester": 1,
      "department": "Computer Science and Engineering",
      "description": "Introduction to programming concepts using C language. Topics include data types, operators, control structures, functions, arrays, pointers, and file handling.",
      "syllabus": [
        {
          "unit": "Unit 1: Introduction to Programming",
          "topics": [
            "Introduction to Computer Programming",
            "Problem Solving Techniques",
            "Algorithm Development",
            "Flowcharts and Pseudocode"
          ]
        },
        {
          "unit": "Unit 2: C Programming Basics",
          "topics": [
            "C Character Set, Tokens, Keywords",
            "Data Types and Variables",
            "Operators and Expressions",
            "Input/Output Functions"
          ]
        },
        {
          "unit": "Unit 3: Control Structures",
          "topics": [
            "Decision Making: if, if-else, nested if, switch",
            "Loops: for, while, do-while",
            "Jump Statements: break, continue, goto"
          ]
        },
        {
          "unit": "Unit 4: Arrays and Strings",
          "topics": [
            "One-dimensional Arrays",
            "Multi-dimensional Arrays",
            "String Handling Functions",
            "Array of Strings"
          ]
        },
        {
          "unit": "Unit 5: Functions and Pointers",
          "topics": [
            "Function Declaration and Definition",
            "Parameter Passing: Call by Value and Call by Reference",
            "Recursion",
            "Pointers: Concepts and Applications"
          ]
        }
      ],
      "books": [
        {
          "title": "Let Us C",
          "author": "Yashavant Kanetkar",
          "publisher": "BPB Publications",
          "edition": "16th Edition"
        },
        {
          "title": "Programming in ANSI C",
          "author": "E. Balagurusamy",
          "publisher": "McGraw Hill Education",
          "edition": "8th Edition"
        },
        {
          "title": "The C Programming Language",
          "author": "Brian W. Kernighan and Dennis M. Ritchie",
          "publisher": "Prentice Hall",
          "edition": "2nd Edition"
        }
      ],
      "resources": [
