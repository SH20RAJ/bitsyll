    {
      "id": "PH24101",
      "code": "PH24101",
      "title": "Physics",
      "credits": 4,
      "semester": 1,
      "department": "Physics",
      "description": "This course covers fundamental physics concepts including mechanics, waves, optics, and modern physics with applications in engineering.",
      "syllabus": [
        {
          "unit": "Unit 1: Mechanics",
          "topics": [
            "Newton's Laws of Motion",
            "Work, Energy, and Power",
            "Rotational Dynamics",
            "Gravitation"
          ]
        },
        {
          "unit": "Unit 2: Waves and Oscillations",
          "topics": [
            "Simple Harmonic Motion",
            "Damped and Forced Oscillations",
            "Wave Motion",
            "Superposition of Waves"
          ]
        },
        {
          "unit": "Unit 3: Optics",
          "topics": [
            "Interference",
            "Diffraction",
            "Polarization",
            "Optical Instruments"
          ]
        },
        {
          "unit": "Unit 4: Electromagnetism",
          "topics": [
            "Electric Fields and Potentials",
            "Magnetic Fields",
            "Electromagnetic Induction",
            "Maxwell's Equations"
          ]
        },
        {
          "unit": "Unit 5: Modern Physics",
          "topics": [
            "Special Theory of Relativity",
            "Quantum Mechanics",
            "Atomic Structure",
            "Nuclear Physics"
          ]
        }
      ],
